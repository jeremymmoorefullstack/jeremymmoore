@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Profile Profile

<section class="ask" id="ask" aria-labelledby="ask-title">
    <header class="ask-head">
        <span class="ask-mark" aria-hidden="true">&gt;_</span>
        <div>
            <h2 id="ask-title">Ask Jeremy's AI</h2>
            <p>grounded in his resume · no guessing</p>
        </div>
        <span class="ask-status" data-state="@StatusKey">@StatusText</span>
    </header>

    @if (_callConnecting)
    {
        <div class="ask-call is-connecting" role="status">
            <span class="ask-pulse" aria-hidden="true"></span>
            <div>
                <strong>Connecting your call…</strong>
                <span>Allow the microphone if your browser asks. This takes a few seconds.</span>
            </div>
        </div>
    }
    else if (_session is Session.Voice)
    {
        <div class="ask-call is-live" role="status">
            <span class="ask-pulse" aria-hidden="true"></span>
            <div>
                <strong>You're live. Go ahead and talk.</strong>
                <span>@(_speaking ? "The agent is speaking…" : "Listening…") · @Elapsed</span>
            </div>
            <button type="button" class="btn btn-small" @onclick="EndVoiceAsync">End call</button>
        </div>
    }

    <ol class="ask-log" @ref="_log" aria-live="polite">
        @if (_lines.Count == 0)
        {
            <li class="ask-empty">Ask about his .NET work, the AI agents he's shipped, or whether he's available. Type, or use the mic to talk.</li>
        }
        @foreach (var line in _lines)
        {
            <li class="ask-line is-@line.Role">@line.Text</li>
        }
        @if (_waiting)
        {
            <li class="ask-line is-ai is-typing" aria-label="The agent is replying"><span></span><span></span><span></span></li>
        }
    </ol>

    <div class="ask-chips">
        @foreach (var prompt in Prompts)
        {
            <button type="button" disabled="@(!CanSend)" @onclick="() => SendAsync(prompt)">@prompt</button>
        }
    </div>

    <form class="ask-input" @onsubmit="() => SendAsync(_draft)" @onsubmit:preventDefault>
        <input id="ask-input" @bind="_draft" @bind:event="oninput" disabled="@(!CanSend)"
               placeholder="@Placeholder" aria-label="Ask a question about Jeremy's work" maxlength="500" autocomplete="off" />
        <button type="button" class="ask-mic @(_session is Session.Voice ? "is-live" : "")" disabled="@(_available is not true || _connecting)"
                @onclick="ToggleVoiceAsync" aria-label="@(_session is Session.Voice ? "End voice call" : "Talk instead")">
            @if (_callConnecting)
            {
                <span class="ask-spinner" aria-hidden="true"></span>@:Connecting…
            }
            else
            {
                @(_session is Session.Voice ? $"End {Elapsed}" : "Talk")
            }
        </button>
        <button type="submit" class="ask-send" disabled="@(!CanSend || string.IsNullOrWhiteSpace(_draft))" aria-label="Send">→</button>
    </form>

    <p class="ask-note">
        @if (_available is false)
        {
            @:The agent is offline. Email <a href="mailto:@Email">@Email</a> instead.
        }
        else
        {
            @:Built by Jeremy: C# on Azure Functions + ElevenLabs. Conversations are logged; voice calls cap at five minutes.
        }
    </p>
</section>

@code {
    private static readonly string[] Prompts =
        ["What AI has he shipped?", "Is he strong in .NET?", "What does he automate?", "Is he available?"];

    private readonly List<ChatLine> _lines = [];
    private IJSObjectReference? _module;
    private DotNetObjectReference<AskMyAi>? _self;
    private ElementReference _log;
    private CancellationTokenSource? _callClock;
    private bool? _available;
    private Session _session = Session.None;
    private bool _connecting;
    private bool _callConnecting;
    private bool _waiting;
    private bool _speaking;
    private string _draft = "";
    private TimeSpan _elapsed;
    private (int Lines, bool Waiting) _rendered;

    private bool CanSend => _available is true && !_connecting && !_waiting && _session is not Session.Voice;

    private string Email => Profile.Contact.First(link => link.Href.StartsWith("mailto:")).Display;

    private string Elapsed => $"{(int)_elapsed.TotalMinutes}:{_elapsed.Seconds:00}";

    private string Placeholder => _available switch
    {
        false => "The agent is offline right now",
        _ when _session is Session.Voice => "On a voice call…",
        _ => "Ask anything about Jeremy's work…",
    };

    private string StatusKey => _available switch
    {
        null => "loading",
        false => "offline",
        _ when _connecting => "connecting",
        _ when _session is Session.Voice => "call",
        _ => "live",
    };

    private string StatusText => StatusKey switch
    {
        "loading" => "Starting",
        "offline" => "Offline",
        "connecting" => "Connecting",
        "call" => _speaking ? "Speaking" : "Listening",
        _ => "Live",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/agent.js");
            _available = await _module.InvokeAsync<bool>("available");
            StateHasChanged();
            return;
        }

        // A reply replacing the typing dots keeps the row count the same, so track both.
        var shape = (_lines.Count, _waiting);
        if (_module is not null && shape != _rendered)
        {
            _rendered = shape;
            await _module.InvokeVoidAsync("scrollToEnd", _log);
        }
    }

    private async Task SendAsync(string text)
    {
        text = text.Trim();
        if (text.Length == 0 || !CanSend)
        {
            return;
        }

        var context = Transcript();
        _draft = "";
        _lines.Add(new("you", text));
        _waiting = true;

        if (_session is not Session.Text)
        {
            _connecting = true;
            StateHasChanged();
            var result = await Start("startText", context);
            _connecting = false;
            if (result != "live")
            {
                _waiting = false;
                _lines.Add(new("note", Problem(result)));
                return;
            }

            _session = Session.Text;
        }

        await _module!.InvokeVoidAsync("send", text);
    }

    private async Task ToggleVoiceAsync()
    {
        if (_session is Session.Voice)
        {
            await EndVoiceAsync();
            return;
        }

        _connecting = _callConnecting = true;
        var result = await Start("startVoice", Transcript());
        _connecting = _callConnecting = false;
        if (result != "live")
        {
            _lines.Add(new("note", Problem(result)));
            return;
        }

        _session = Session.Voice;
        _speaking = false;
        _ = RunCallClockAsync();
    }

    private async Task<string> Start(string method, string? context)
    {
        _self ??= DotNetObjectReference.Create(this);
        return await _module!.InvokeAsync<string>(method, _self, context);
    }

    private async Task EndVoiceAsync()
    {
        _callClock?.Cancel();
        await _module!.InvokeVoidAsync("stop");
    }

    private async Task RunCallClockAsync()
    {
        _callClock = new CancellationTokenSource();
        var started = DateTimeOffset.UtcNow;
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_callClock.Token))
            {
                _elapsed = DateTimeOffset.UtcNow - started;
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // A reconnect is a new session, so the agent gets what was said before.
    private string? Transcript() =>
        _lines.Count == 0
            ? null
            : string.Join("\n", _lines.Where(line => line.Role != "note")
                .Select(line => $"{(line.Role == "you" ? "Visitor" : "Agent")}: {line.Text}"));

    private string Problem(string result) => result switch
    {
        "microphone" => "Voice needs your microphone. Allow it and try again, or just type.",
        "busy" => $"The agent has had a lot of conversations. Try again later, or email {Email}.",
        "timeout" => "The call couldn't connect. Try again in a minute, or just type.",
        _ => $"The agent isn't answering right now. Email {Email} instead.",
    };

    [JSInvokable]
    public void OnMessage(string source, string text)
    {
        if (source == "ai")
        {
            _waiting = false;
        }

        _lines.Add(new(source == "ai" ? "ai" : "you", text));
        StateHasChanged();
    }

    [JSInvokable]
    public void OnNoMicrophoneInput()
    {
        _lines.Add(new("note",
            "The agent isn't hearing your microphone. Check the input device and that your browser has mic access in system settings, or end the call and type instead."));
        StateHasChanged();
    }

    [JSInvokable]
    public void OnModeChanged(string mode)
    {
        _speaking = mode == "speaking";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEnded(string kind)
    {
        _callClock?.Cancel();
        _session = Session.None;
        _speaking = false;
        _waiting = false;
        if (kind == "voice")
        {
            _lines.Add(new("note", "Call ended. You can keep typing."));
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _callClock?.Cancel();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    private sealed record ChatLine(string Role, string Text);

    private enum Session { None, Text, Voice }
}
