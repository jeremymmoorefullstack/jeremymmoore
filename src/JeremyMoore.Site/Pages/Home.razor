@page "/"
@inject Profile Profile

<PageTitle>@Profile.Name · C# / .NET Engineer</PageTitle>

<Hero />

<Section Index="01" Title="About">
    <p class="summary">@Profile.Summary</p>
</Section>

<Section Index="02" Title="Work">
    <WorkList Studies="Profile.CaseStudies" />
</Section>

<Section Index="03" Title="Experience">
    <ExperienceList Roles="Profile.ExperienceNewestFirst" />
</Section>

<Section Index="04" Title="Skills">
    <SkillGroups Groups="Profile.Skills" />
</Section>

<Section Index="05" Title="Education">
    <EducationList Degrees="Profile.Education" />
</Section>

<Section Index="06" Title="Projects">
    <ProjectList Projects="Profile.Projects" />
</Section>

<Section Index="07" Title="FAQ">
    <FaqList Items="Profile.Faq" />
</Section>

<Section Index="08" Title="Contact">
    <ContactLinks Links="Profile.Contact" />
</Section>
